<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.actividadpracticapaesemana5.controller.ClienteDetalleController"
            prefHeight="450.0" prefWidth="650.0">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Detalle del Cliente"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="30.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- Foto -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="imgFoto"
                           fitWidth="150" fitHeight="150"
                           preserveRatio="true"/>
                <Label text="Fotografía"/>
            </VBox>

            <!-- Datos -->
            <GridPane hgap="15" vgap="12">
                <Label text="Nombre completo:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblNombre"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tipo de cliente:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblTipo"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Ciudad:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="lblCiudad"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Fecha de nacimiento:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="lblFecha"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Tipo de solicitud:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="lblSolicitud"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Servicios:" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label fx:id="lblServicios"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Button text="Regresar a Consulta" onAction="#regresarConsulta"/>
            <Button text="Regresar al Menú Principal" onAction="#regresarMenu"
                    style="-fx-base: #3498db;"/>
        </HBox>
    </bottom>

</BorderPane>