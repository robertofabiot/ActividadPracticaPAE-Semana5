<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: #0F172A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.ClienteConsultaController">

    <children>
        <VBox spacing="15.0" style="-fx-background-color: #1E293B;                    -fx-border-color: linear-gradient(to right, #8B5CF6, #EC4899, #3B82F6);                    -fx-border-width: 2.5px;                    -fx-border-radius: 12;                    -fx-background-radius: 12;" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <MenuBar>
                <menus>
                    <Menu text="Navegación">
                        <items>
                            <MenuItem fx:id="miIrMenu"     text="Menú Principal" onAction="#irAlMenu"/>
                            <MenuItem fx:id="miIrRegistro" text="Registro"       onAction="#irARegistro"/>
                            <MenuItem fx:id="miIrConsulta" text="Consulta"       onAction="#irAConsulta"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <!-- Encabezado -->
                <VBox spacing="3.0">
                    <children>
                        <Label style="-fx-text-fill: #F8FAFC; -fx-font-size: 20px; -fx-font-weight: bold;" text="CONSULTA DE CLIENTES" />
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="Haz doble clic sobre un registro para ver el detalle o editar." />
                    </children>
                </VBox>

                <!-- TableView -->
                <TableView fx:id="tblClientes" onMouseClicked="#onTableClicked" style="-fx-background-color: #0F172A;                               -fx-base: #1E293B;                               -fx-control-inner-background: #0F172A;                               -fx-table-cell-border-color: transparent;                               -fx-border-color: #334155;                               -fx-border-radius: 8;                               -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre Completo" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="120.0" text="Tipo Cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="110.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="130.0" text="Fecha Nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="140.0" text="Tipo Solicitud" />
                        <TableColumn fx:id="colFechaHora" prefWidth="160.0" text="Registrado" />

                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Volver al menu -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onVolverMenu" style="-fx-background-color: #3B82F6;                                  -fx-text-fill: white;                                  -fx-font-weight: bold;                                  -fx-font-size: 13px;                                  -fx-background-radius: 8;                                  -fx-padding: 8 20 8 20;                                  -fx-cursor: hand;" text="Regresar al Menú  🏠" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
