<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: #f1f5f9; -fx-font-family: 'Roboto Light';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.ClienteConsultaController">
    <children>
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.2), 16, 0, 0, 4);" AnchorPane.bottomAnchor="18" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">
            <padding>
                <Insets bottom="22" left="26" right="26" top="22" />
            </padding>
            <children>
                <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light';" text="Consulta de Clientes">
                    <font>
                        <Font name="Roboto Light" size="23.0" />
                    </font>
                </Label>

                <Separator />

                <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-family: 'Roboto Light';" text="Haz doble clic sobre un registro para consultar el detalle completo del cliente." />

                <TableView fx:id="tblClientes" onMouseClicked="#onTableClicked" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Roboto Light'; -fx-selection-bar: #b5c9c3; -fx-selection-bar-non-focused: #cfd8d7;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre Completo" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="120.0" text="Tipo Cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="110.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="130.0" text="Fecha Nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="140.0" text="Tipo Solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onVolverMenu" style="-fx-background-color: #4a6670; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 20 8 20; -fx-cursor: hand; -fx-font-family: 'Roboto Light';" text="Regresar al Menú" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
