<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.ClienteRegistroController">
  <children>
    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #94a3b855, 16, 0, 0, 4);" AnchorPane.bottomAnchor="18" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">
      <padding><Insets bottom="22" left="26" right="26" top="22" /></padding>
      <children>
        <Label prefHeight="70.0" prefWidth="381.0" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Registro de cliente" />
        <Separator />
        <HBox spacing="24" VBox.vgrow="ALWAYS">
          <children>
            <GridPane hgap="12" vgap="12" HBox.hgrow="ALWAYS">
              <columnConstraints><ColumnConstraints halignment="RIGHT" minWidth="130" /><ColumnConstraints hgrow="ALWAYS" minWidth="250" /></columnConstraints>
              <children>
                <Label text="Nombres *:" GridPane.columnIndex="0" GridPane.rowIndex="0" /><TextField fx:id="txtNombres" onAction="#avanzarApellidos" promptText="Solo letras" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Apellidos *:" GridPane.columnIndex="0" GridPane.rowIndex="1" /><TextField fx:id="txtApellidos" onAction="#avanzarTelefono" promptText="Solo letras" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Teléfono *:" GridPane.columnIndex="0" GridPane.rowIndex="2" /><TextField fx:id="txtTelefono" onAction="#avanzarTipoCliente" promptText="8 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Tipo de cliente *:" GridPane.columnIndex="0" GridPane.rowIndex="3" /><ComboBox fx:id="cmbTipoCliente" onAction="#avanzarCiudad" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Ciudad *:" GridPane.columnIndex="0" GridPane.rowIndex="4" /><ComboBox fx:id="cmbCiudad" onAction="#avanzarFecha" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Fecha nacimiento *:" GridPane.columnIndex="0" GridPane.rowIndex="5" /><DatePicker fx:id="dpFechaNacimiento" onAction="#avanzarSolicitud" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label text="Tipo de solicitud *:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="6"><children>
                  <RadioButton fx:id="rbInformacion" mnemonicParsing="false" text="Información"><toggleGroup><ToggleGroup fx:id="grupoSolicitud" /></toggleGroup></RadioButton>
                  <RadioButton fx:id="rbServicio" mnemonicParsing="false" text="Servicio" toggleGroup="$grupoSolicitud" />
                  <RadioButton fx:id="rbReclamo" mnemonicParsing="false" text="Reclamo" toggleGroup="$grupoSolicitud" />
                </children></HBox>
                <Label text="Servicios:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="7"><children>
                  <CheckBox fx:id="chkInternet" mnemonicParsing="false" text="Internet" /><CheckBox fx:id="chkTelefonia" mnemonicParsing="false" text="Telefonía" /><CheckBox fx:id="chkSoporte" mnemonicParsing="false" text="Soporte" />
                </children></HBox>
              </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
            </GridPane>
            <VBox alignment="TOP_CENTER" prefWidth="180" spacing="10"><children>
              <ImageView fx:id="imgFotografia" fitHeight="150" fitWidth="160" preserveRatio="true" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
              <Label style="-fx-text-fill: #64748b;" text="Fotografía (opcional)" /><Button mnemonicParsing="false" onAction="#seleccionarFotografia" text="Seleccionar imagen" />
            </children></VBox>
          </children>
        </HBox>
        <Label fx:id="lblEstado" style="-fx-text-fill: #475569;" text="Listo para registrar un cliente." />
        <HBox alignment="CENTER_RIGHT" spacing="10"><children>
          <Button mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" /><Button mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
          <Button defaultButton="true" mnemonicParsing="false" onAction="#guardarCliente" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
        </children></HBox>
      </children>
    </VBox>
  </children>
</AnchorPane>
