<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: #f1f5f9; -fx-font-family: 'Roboto Light';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.ClienteRegistroController">
  <children>
    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.2), 16, 0, 0, 4);" AnchorPane.bottomAnchor="18" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">
      <padding><Insets bottom="22" left="26" right="26" top="22" /></padding>
      <children>
        <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light';" text="Registro de Cliente">
          <font>
            <Font name="Roboto Light" size="23.0" />
          </font>
        </Label>
        <Separator />
        <HBox spacing="24" VBox.vgrow="ALWAYS">
          <children>
            <GridPane hgap="12" vgap="12" HBox.hgrow="ALWAYS">
              <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="130" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
              </columnConstraints>
              <children>
                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Nombres *:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombres" onAction="#avanzarApellidos" promptText="Solo letras" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Apellidos *:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtApellidos" onAction="#avanzarTelefono" promptText="Solo letras" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Teléfono *:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtTelefono" onAction="#avanzarTipoCliente" promptText="8 dígitos" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Tipo de cliente *:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbTipoCliente" maxWidth="Infinity" onAction="#avanzarCiudad" promptText="Seleccione" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Ciudad *:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <ComboBox fx:id="cmbCiudad" maxWidth="Infinity" onAction="#avanzarFecha" promptText="Seleccione" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Fecha nacimiento *:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <DatePicker fx:id="dpFechaNacimiento" maxWidth="Infinity" onAction="#avanzarSolicitud" promptText="dd/mm/aaaa" style="-fx-font-family: 'Roboto Light'; -fx-background-radius: 6; -fx-border-color: #cfd8d7; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Tipo de solicitud *:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <HBox spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="6">
                  <children>
                    <RadioButton fx:id="rbInformacion" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Información">
                      <toggleGroup><ToggleGroup fx:id="grupoSolicitud" /></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rbServicio" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Servicio" toggleGroup="$grupoSolicitud" />
                    <RadioButton fx:id="rbReclamo" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Reclamo" toggleGroup="$grupoSolicitud" />
                  </children>
                </HBox>

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-family: 'Roboto Light';" text="Servicios:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <HBox spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="7">
                  <children>
                    <CheckBox fx:id="chkInternet" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Internet" />
                    <CheckBox fx:id="chkTelefonia" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Telefonía" />
                    <CheckBox fx:id="chkSoporte" mnemonicParsing="false" style="-fx-font-family: 'Roboto Light';" text="Soporte" />
                  </children>
                </HBox>
              </children>
              <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
              </rowConstraints>
            </GridPane>
            <VBox alignment="TOP_CENTER" prefWidth="180" spacing="10">
              <children>
                <ImageView fx:id="imgFotografia" fitHeight="150" fitWidth="160" preserveRatio="true" style="-fx-border-color: #b5c9c3; -fx-border-radius: 8;" />
                <Label style="-fx-text-fill: #64748b; -fx-font-family: 'Roboto Light';" text="Fotografía (opcional)" />
                <Button mnemonicParsing="false" onAction="#seleccionarFotografia" style="-fx-background-color: #f1f5f9; -fx-text-fill: #4a6670; -fx-border-color: #b5c9c3; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Roboto Light';" text="Seleccionar imagen" />
              </children>
            </VBox>
          </children>
        </HBox>
        <Label fx:id="lblEstado" style="-fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light';" text="Listo para registrar un cliente." />
        <HBox alignment="CENTER_RIGHT" spacing="10">
          <children>
            <Button mnemonicParsing="false" onAction="#limpiarFormulario" style="-fx-background-color: #f1f5f9; -fx-text-fill: #4a6670; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Roboto Light'; -fx-padding: 7 16 7 16;" text="Limpiar" />
            <Button mnemonicParsing="false" onAction="#cancelar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Roboto Light'; -fx-padding: 7 16 7 16;" text="Cancelar" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#guardarCliente" style="-fx-background-color: #4a6670; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Roboto Light'; -fx-padding: 7 20 7 20;" text="Guardar" />
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</AnchorPane>
