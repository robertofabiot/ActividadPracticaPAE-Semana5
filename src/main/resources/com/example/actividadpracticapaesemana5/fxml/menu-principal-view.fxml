<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.actividadpracticapaesemana5.controller.MenuPrincipalController"
            prefHeight="480.0" prefWidth="700.0">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem text="Registrar Cliente" onAction="#abrirRegistro"/>
                            <MenuItem text="Consultar Clientes" onAction="#abrirConsulta"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Cerrar Sesión" onAction="#cerrarSesion"/>
                            <MenuItem text="Salir" onAction="#salir"/>
                        </items>
                    </Menu>
                    <Menu text="Navegación">
                        <items>
                            <MenuItem fx:id="miIrMenu"     text="Menú Principal" onAction="#irAlMenu"/>
                            <MenuItem fx:id="miIrRegistro" text="Registro"       onAction="#abrirRegistro"/>
                            <MenuItem fx:id="miIrConsulta" text="Consulta"       onAction="#abrirConsulta"/>
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca de..." onAction="#acercaDe"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <items>
                    <Button text="Registrar Cliente" onAction="#abrirRegistro"/>
                    <Button text="Consultar Clientes" onAction="#abrirConsulta"/>
                    <Separator/>
                    <Button text="Salir" onAction="#salir"/>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25.0">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label fx:id="lblBienvenida"
                   text="Menú Principal"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;">
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="Ir a Registro" onAction="#abrirRegistro"/>
                            <MenuItem text="Ir a Consulta" onAction="#abrirConsulta"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Cerrar Sesión" onAction="#cerrarSesion"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </Label>

            <HBox alignment="CENTER" spacing="30.0">
                <Button text="Registrar Cliente"
                        onAction="#abrirRegistro"
                        prefWidth="200" prefHeight="80"
                        style="-fx-font-size: 16px;"/>

                <Button text="Consultar Clientes"
                        onAction="#abrirConsulta"
                        prefWidth="200" prefHeight="80"
                        style="-fx-font-size: 16px;"/>


            </HBox>

            <Label text="Tip: clic derecho sobre el título para ver más opciones."
                   style="-fx-text-fill: gray;"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <Label fx:id="lblEstado" text="Listo"/>
        </HBox>
    </bottom>
</BorderPane>