<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: #f1f5f9; -fx-font-family: 'Roboto Light';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.MenuPrincipalController">
    <children>
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.2), 16, 0, 0, 4);" AnchorPane.bottomAnchor="18" AnchorPane.leftAnchor="18" AnchorPane.rightAnchor="18" AnchorPane.topAnchor="18">
            <padding>
                <Insets bottom="22" left="26" right="26" top="22" />
            </padding>
            <children>
                <MenuBar style="-fx-background-color: transparent; -fx-font-family: 'Roboto Light'; -fx-padding: 0;">
                    <menus>
                        <Menu text="Archivo">
                            <items>
                                <MenuItem onAction="#abrirRegistro" text="Registrar Cliente" />
                                <MenuItem onAction="#abrirConsulta" text="Consultar Clientes" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#cerrarSesion" text="Cerrar Sesión" />
                                <MenuItem onAction="#salir" text="Salir" />
                            </items>
                        </Menu>
                        <Menu text="Ayuda">
                            <items>
                                <MenuItem onAction="#acercaDe" text="Acerca de..." />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <ToolBar style="-fx-background-color: #f8fafc; -fx-border-color: #cfd8d7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8;">
                    <items>
                        <Button mnemonicParsing="false" onAction="#abrirRegistro" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light'; -fx-cursor: hand; -fx-padding: 5 12;" text="Registrar Cliente" />
                        <Button mnemonicParsing="false" onAction="#abrirConsulta" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light'; -fx-cursor: hand; -fx-padding: 5 12;" text="Consultar Clientes" />
                        <Separator orientation="VERTICAL" />
                        <Button mnemonicParsing="false" onAction="#salir" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #64748b; -fx-font-family: 'Roboto Light'; -fx-cursor: hand; -fx-padding: 5 12;" text="Salir" />
                    </items>
                </ToolBar>

                <Label fx:id="lblBienvenida" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light';" text="Menú Principal">
                    <font>
                        <Font name="Roboto Light" size="23.0" />
                    </font>
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem onAction="#abrirRegistro" text="Ir a Registro" />
                                <MenuItem onAction="#abrirConsulta" text="Ir a Consulta" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#cerrarSesion" text="Cerrar Sesión" />
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </Label>

                <Separator />

                <VBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-family: 'Roboto Light';" text="Selecciona una opción para gestionar clientes o consultar los registros" />

                        <HBox alignment="CENTER" spacing="30.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#abrirRegistro" prefHeight="90.0" prefWidth="220.0" style="-fx-background-color: #4a6670; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-family: 'Roboto Light'; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.25), 10, 0, 0, 3);" text="Registrar Cliente" />
                                <Button mnemonicParsing="false" onAction="#abrirConsulta" prefHeight="90.0" prefWidth="220.0" style="-fx-background-color: white; -fx-border-color: #4a6670; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #4a6670; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-family: 'Roboto Light'; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.15), 10, 0, 0, 3);" text="Consultar Clientes" />
                            </children>
                        </HBox>

                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-family: 'Roboto Light';" text="Tip: haz clic derecho sobre el título para ver más opciones." />
                    </children>
                </VBox>

                <Separator />

                <HBox alignment="CENTER">
                    <children>
                        <Label fx:id="lblEstado" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-family: 'Roboto Light';" text="Programación de Aplicaciones de Escritorio" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>