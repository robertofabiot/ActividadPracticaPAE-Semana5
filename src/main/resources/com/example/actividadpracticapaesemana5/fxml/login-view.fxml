<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="610.0" prefWidth="790.0" style="-fx-background-color: #f1f5f9; -fx-font-family: 'Roboto Light';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.LoginController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox maxWidth="420.0" prefWidth="420.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(74, 102, 112, 0.2), 16, 0, 0, 4);">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="30.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="8.0">
                            <children>
                                <ImageView fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../icons/usuario.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #4a6670; -fx-font-family: 'Roboto Light';" text="Inicio de Sesión">
                                    <font>
                                        <Font name="Roboto Light" size="23.0" />
                                    </font>
                                </Label>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-family: 'Roboto Light';" text="Ingresa tus credenciales para acceder" />
                            </children>
                        </VBox>

                        <Separator />

                        <VBox spacing="6.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-family: 'Roboto Light';" text="Usuario *:" />
                                <HBox alignment="CENTER_LEFT" prefHeight="38.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 10 0 10;">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../icons/usuarioField.png" />
                                            </image>
                                        </ImageView>
                                        <TextField fx:id="txtUsuario" promptText="Nombre de usuario" style="-fx-background-color: transparent; -fx-font-family: 'Roboto Light'; -fx-text-fill: #0f172a; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-family: 'Roboto Light';" text="Contraseña *:" />
                                <HBox alignment="CENTER_LEFT" prefHeight="38.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #cfd8d7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 10 0 10;">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../icons/passwordField.png" />
                                            </image>
                                        </ImageView>
                                        <PasswordField fx:id="txtPassword" promptText="Contraseña" style="-fx-background-color: transparent; -fx-font-family: 'Roboto Light'; -fx-text-fill: #0f172a; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <VBox.margin>
                                <Insets top="8.0" />
                            </VBox.margin>
                            <children>
                                <Button fx:id="btnEntrar" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onEntrarClick" prefHeight="40.0" style="-fx-background-color: #4a6670; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Roboto Light';" text="Iniciar Sesión" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
