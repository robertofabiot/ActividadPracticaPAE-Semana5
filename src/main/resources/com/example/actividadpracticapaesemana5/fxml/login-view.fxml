<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="380.0" spacing="20.0" style="-fx-background-color: #bce2f1; -fx-padding: 40 30 40 30;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividadpracticapaesemana5.controller.LoginController">
    <children>
        <!-- Icono de usuario centrado y en la parte superior -->
        <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../icons/usuario.png" />
            </image>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </ImageView>

        <!-- Campo de Usuario con icono a la izquierda y borde inferior -->
        <HBox alignment="CENTER_LEFT" maxWidth="260.0" prefHeight="36.0" spacing="10.0" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #486581 transparent; -fx-border-width: 0 0 1.5 0; -fx-padding: 2 6 4 6;">
            <children>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../icons/usuarioField.png" />
                    </image>
                </ImageView>
                <TextField fx:id="txtUsuario" alignment="CENTER" promptText="Nombre de usuario" style="-fx-background-color: transparent; -fx-prompt-text-fill: #5a7a94; -fx-text-fill: #102a43; -fx-font-size: 13px;" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="JetBrainsMono NFM SemiBold" size="13.0" />
               </font></TextField>
            </children>
        </HBox>

        <!-- Campo de Contraseña con icono a la izquierda y borde inferior -->
        <HBox alignment="CENTER_LEFT" maxWidth="260.0" prefHeight="36.0" spacing="10.0" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #486581 transparent; -fx-border-width: 0 0 1.5 0; -fx-padding: 2 6 4 6;">
            <children>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../icons/passwordField.png" />
                    </image>
                </ImageView>
                <PasswordField fx:id="txtPassword" alignment="CENTER" promptText="Contraseña" style="-fx-background-color: transparent; -fx-prompt-text-fill: #5a7a94; -fx-text-fill: #102a43; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- Botón de Entrar -->
        <Button fx:id="btnEntrar" defaultButton="true" mnemonicParsing="false" prefHeight="38.0" prefWidth="260.0" style="-fx-background-color: #3b82f6; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Entrar">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
         <font>
            <Font name="JetBrainsMono NFM SemiBold" size="13.0" />
         </font>
        </Button>
    </children>
</VBox>
